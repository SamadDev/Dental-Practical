APP_NAME="Dental Practi-Smart"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Baghdad
# APP_URL drives Storage::url() for X-ray links. On the clinic LAN this MUST be
# the reception PC's IP (e.g. http://192.168.1.50:8000), otherwise tablets
# resolve "localhost" to their own device and X-rays 404.
APP_URL=http://localhost:8000

# --- Local LAN MySQL ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dental_practismart
DB_USERNAME=root
DB_PASSWORD=

# --- Backups ---
# Mount a USB drive and point this at it (Windows: D:\clinic_backups, Mac: /Volumes/USB)
BACKUP_PATH=/Volumes/USB/clinic_backups

# --- Storage ---
FILESYSTEM_DISK=public

# --- Sessions ---
# The `web` middleware group (used by the GET / status route) needs a session
# store. `database` uses the `sessions` table created by the default migration.
SESSION_DRIVER=database

# --- API tokens (Sanctum) ---
# Minutes before an issued API token expires. 43200 = 30 days.
SANCTUM_EXPIRATION=43200
